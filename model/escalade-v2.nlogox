  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="genetique-morphologie" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>reussite-num</metric>
        <metric>hauteur-max-m</metric>
        <metric>fatigue-globale</metric>
        <metric>nb-chutes</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mode-voie">
          <value value="&quot;aleatoire&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="poids">
          <value value="55"></value>
          <value value="70"></value>
          <value value="85"></value>
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="dist-cdg-mains">
          <value value="60"></value>
          <value value="70"></value>
          <value value="80"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="force-mains">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="force-pieds">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="endurance-mains">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="endurance-pieds">
          <value value="3"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="technique-entrainement" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>reussite-num</metric>
        <metric>hauteur-max-m</metric>
        <metric>fatigue-globale</metric>
        <metric>nb-chutes</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="mode-voie">
          <value value="&quot;aleatoire&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="poids">
          <value value="70"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="dist-cdg-mains">
          <value value="70"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="force-mains" first="1" step="1" last="5"></steppedValueSet>
        <steppedValueSet variable="endurance-mains" first="1" step="1" last="5"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
